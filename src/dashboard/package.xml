<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dashboard</name>
  <version>0.1.0</version>
  <description>Live field dashboard: vision, referee state, router state and the debug topics of whatever behaviors publish on /&lt;team&gt;/behaviors/&lt;name&gt;/debug, streamed to a browser page with freeze and scrub.</description>
  <maintainer email="gustavomoura@discente.ufg.br">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>pequi_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
