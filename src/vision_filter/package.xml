<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_filter</name>
  <version>0.1.0</version>
  <description>Per-robot EKF over SSL-Vision: filtered poses and body velocities (/vision/filtered/*), plus fake_vision and vision_check test tools.</description>
  <maintainer email="gustavomoura@discente.ufg.br">gus</maintainer>
  <license>Apache-2.0</license>

  <test_depend>python3-pytest</test_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ssl_vision_connector</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
