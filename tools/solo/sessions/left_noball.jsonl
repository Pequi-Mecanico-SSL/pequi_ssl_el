# A 10-minute session in the left half of a shared field (x < 0), without the ball: the ball on the field is not ours
# and is never touched; a ball rolling into a test's area holds that test (quietly) or moves it to the end.
# Home area x -2.2..-0.10, y -1.45..1.45 (set in the header; --home overrides). P: the plan folder (default plans/ next to this file); OUT: logs and results (default $SOLO_DATA/sessions).
# Run: python3 tools/solo/auto_session.py <team> tools/solo/sessions/left_noball.jsonl --budget 10
{"kind": "session", "name": "left_noball", "budget_min": 10, "ball": "ignore", "home": "-2.2,-0.10,-1.45,1.45", "vars": {"P": "${SESSION_DIR}/plans", "OUT": "${SOLO_DATA}/sessions"}, "env": {"SOLO_BOX": "-2.2,-0.10,-1.45,1.45", "SOLO_BRAKE": "auto", "SOLO_BRAKE_FIRST": "1.2"}}
{"kind": "marker", "label": "start marker", "text": "left-half session without the ball: start (auto_session)", "data": "use"}
{"kind": "strategy", "label": "strategy off (it was started with run_real.sh)", "on": false}
{"kind": "series", "label": "reference + ramped 1.5 m/s runs fwd and side, lane Y1 (plan left_A 1-8)", "plan": "${P}/left_A_ramped.jsonl", "max": 8, "args": ["--out", "${OUT}/logs", "--results", "${OUT}/results.jsonl"], "env": {"SOLO_BOX": "", "SOLO_RAMP": "1.7"}, "timeout": 360, "on_fail": "alert"}
{"kind": "series", "label": "spins and gyro scale at S1 (plan left_C)", "plan": "${P}/left_C_spins.jsonl", "args": ["--out", "${OUT}/logs", "--results", "${OUT}/results.jsonl"], "env": {"SOLO_BOX": ""}, "timeout": 240, "on_fail": "alert"}
{"kind": "series", "label": "command jumps, lane Y2 (plan left_B 1-4)", "plan": "${P}/left_B_jumps.jsonl", "max": 4, "args": ["--out", "${OUT}/logs", "--results", "${OUT}/results.jsonl"], "env": {"SOLO_BOX": ""}, "timeout": 200, "on_fail": "alert"}
{"kind": "series", "label": "reference again (plan left_G)", "plan": "${P}/left_G_reference.jsonl", "args": ["--out", "${OUT}/logs", "--results", "${OUT}/results.jsonl"], "env": {"SOLO_BOX": "", "SOLO_RAMP": "1.7"}, "timeout": 120, "on_fail": "alert"}
{"kind": "marker", "label": "end marker", "text": "left-half session without the ball: end (auto_session)", "data": "skip", "final": true}
{"kind": "cmd", "label": "save the robot log", "argv": ["${T}/robot_stack.sh", "save"], "final": true, "timeout": 90}
